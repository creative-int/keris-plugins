{
	"name": "@creative-int/keris-plugins",
	"version": "0.1.0",
	"private": true,
	"description": "Keris Cursor, Codex, and Claude Code plugin manifests, the keris-video-proof skill, and MCP wiring — generated from one canonical config.",
	"keywords": ["keris", "agent-skills", "mcp", "proof", "video"],
	"homepage": "https://keris.video",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/creative-int/keris-plugins.git"
	},
	"type": "module",
	"files": [
		".claude-plugin",
		".codex-plugin",
		".cursor-plugin",
		".mcp.json",
		"server.json",
		"LICENSE",
		"README.md",
		"assets/logo.png",
		"skills"
	],
	"scripts": {
		"generate": "node tooling/generate.ts",
		"check:generated": "node tooling/generate.ts --check",
		"typecheck": "tsc --noEmit",
		"smoke": "node tooling/smoke.ts",
		"verify": "pnpm run check:generated && pnpm run typecheck && pnpm run smoke"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22 <23",
		"pnpm": ">=10.28.2"
	}
}
